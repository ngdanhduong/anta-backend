# ========================================================
# Biến môi trường mẫu cho Hệ thống Alobo Court (.env.example)
# Chuẩn 12-Factor App - Tuyệt đối không commit secret thật lên Git
# ========================================================

# Cơ sở dữ liệu PostgreSQL
DB_USER=anta
DB_PASSWORD=anta_local_secret_example
DB_NAME=anta
DB_PORT=55432

# Redis Cache & Lock
REDIS_PORT=56379

# RabbitMQ Message Broker
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672

# Network Endpoints giữa các Microservices (Docker DNS)
FIELD_SERVICE_URL=http://field-service:8081
CONNECT_TIMEOUT=2.0
READ_TIMEOUT=3.0
MAX_RETRIES=3

# Cổng truy cập bên ngoài Host
GATEWAY_PORT=8000
BOOKING_SERVICE_PORT=8080
FIELD_SERVICE_PORT=8081
