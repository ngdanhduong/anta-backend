{
  "info": {
    "name": "Anta Microservices Service Discovery Collection",
    "description": "Bộ kiểm thử Service Discovery và Load Balancing cho Bài thực hành số 7",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01. Eureka Dashboard Status",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "http://localhost:8761/eureka/apps",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8761",
          "path": ["eureka", "apps"]
        }
      }
    },
    {
