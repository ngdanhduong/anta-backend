          "protocol": "http",
          "host": ["localhost"],
          "port": "8083",
          "path": ["api", "v1", "bookings", "yards"]
        }
      }
    },
    {
      "name": "06. Create Booking via Service Discovery",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"yardId\": \"yard-01\",\n  \"userId\": \"customer-anta-01\",\n  \"slot\": \"18:00-19:00\"\n}"
        },
        "url": {
          "raw": "http://localhost:8083/api/v1/bookings",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8083",
          "path": ["api", "v1", "bookings"]
        }
