          "protocol": "http",
          "host": ["localhost"],
          "port": "8081",
          "path": ["api", "v1", "instance-info"]
        }
      }
    },
    {
      "name": "03. Yard Service Instance 2 Info",
      "request": {
        "method": "GET",
        "url": {
